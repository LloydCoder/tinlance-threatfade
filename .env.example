# Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# API security. Leave THREATFADE_API_KEY empty for local development.
THREATFADE_API_KEY=
THREATFADE_MAX_PCAP_BYTES=104857600
THREATFADE_RATE_LIMIT=120
THREATFADE_RATE_WINDOW_SECONDS=60
THREATFADE_ALLOWED_ORIGINS=http://localhost:8080

# Production OIDC resource-server validation
THREATFADE_OIDC_ISSUER=
THREATFADE_OIDC_AUDIENCE=
THREATFADE_OIDC_JWKS_URL=
THREATFADE_OIDC_CLOCK_SKEW_SECONDS=30
